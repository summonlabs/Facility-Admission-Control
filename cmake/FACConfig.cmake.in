@PACKAGE_INIT@

# The package version is exported so a consumer can check the artifacts it was
# built against without reading the library's version header.
set(FAC_VERSION "@PROJECT_VERSION@")
set(FAC_DURABLE_FORMAT_REVISION "@PROJECT_VERSION@")

include(CMakeFindDependencyMacro)

include("${CMAKE_CURRENT_LIST_DIR}/FACTargets.cmake")

check_required_components(FAC)
